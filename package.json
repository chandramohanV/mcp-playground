{
  "name": "mcp-playground",
  "version": "0.1.0",
  "description": "Sandbox for building and testing MCP servers",
  "private": true,
  "type": "module",
  "bin": {
    "mcp-playground": "dist/server.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/server.js",
    "test": "npm run build && node --test dist/test/",
    "inspect": "npm run build && npx -y @modelcontextprotocol/inspector node dist/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
